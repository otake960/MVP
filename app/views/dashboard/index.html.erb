<h1><%= t("dashboard.title") %></h1>

<div class="dashboard">
  <div class="user-info">
    <% if current_user %>
      <h2><%= t("dashboard.welcome", name: (current_user.name.presence || "ユーザー")) %></h2>
    <% else %>
      <h2><%= t("dashboard.welcome_guest") %></h2>
    <% end %>
    <p><%= t("dashboard.today") %>: <%= l(Date.today) %></p>
  </div>

  <div class="training-records">
    <h2><%= t("dashboard.records.title") %></h2>
    <table>
      <thead>
        <tr>
          <th><%= t("dashboard.records.date") %></th>
          <th><%= t("dashboard.records.exercise") %></th>
          <th><%= t("dashboard.records.weight") %></th>
          <th><%= t("dashboard.records.reps") %></th>
        </tr>
      </thead>
      <tbody>
        <% if @training_sessions.present? %>
          <% @training_sessions.each do |session| %>
            <% if session.session_exercises.any? %>
              <% session.session_exercises.each do |se| %>
                <tr>
                  <td><%= l(session.date || session.created_at.to_date) %></td>
                  <td><%= se.try(:exercise)&.name || se.try(:name) || "（種目未設定）" %></td>
                  <td><%= se.weight %></td>
                  <td><%= se.reps %></td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td><%= l(session.date || session.created_at.to_date) %></td>
                <td colspan="3" style="color:#666;">このセッションには種目がまだありません</td>
              </tr>
            <% end %>
          <% end %>
        <% else %>
          <tr>
            <td colspan="4"><%= t("dashboard.records.empty") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<style>
  .dashboard { display:flex; flex-direction:column; gap:20px; }
  .user-info, .training-records { border:1px solid #ccc; padding:20px; border-radius:10px; }
  table { width:100%; border-collapse:collapse; }
  table, th, td { border:1px solid #000; }
  th, td { padding:10px; text-align:left; }
</style>
