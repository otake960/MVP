<h1>記録一覧</h1>
<p><%= link_to "新規記録", new_training_session_path %></p>

<% if @training_sessions.present? %>
  <ul>
    <% @training_sessions.each do |ts| %>
      <li><%= link_to (ts.date || ts.created_at.to_date), training_session_path(ts) %></li>
    <% end %>
  </ul>
<% else %>
  <p>記録がありません。</p>
<% end %>
